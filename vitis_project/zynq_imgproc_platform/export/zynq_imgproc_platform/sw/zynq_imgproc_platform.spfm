<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="zynq_imgproc_platform"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
zynq_imgproc_platform
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="zynq_imgproc_platform">
        <sdx:configuration sdx:name="zynq_imgproc_platform"
                           sdx:displayName="zynq_imgproc_platform"
                           sdx:defaultProcessorGroup="standalone_psu_cortexa53_0"
                           sdx:runtimes="cpp">
            <sdx:description>zynq_imgproc_platform</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="zynq_imgproc_platform/boot/zynq_imgproc_platform.bif"
                            sdx:readme="zynq_imgproc_platform/boot/generic.readme"
                            sdx:qemuArguments="zynq_imgproc_platform/qemu/pmu_args.txt:zynq_imgproc_platform/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="zynq_imgproc_platform/boot/zynq_imgproc_platform.bif"
                            sdx:readme="zynq_imgproc_platform/boot/generic.readme"
                            sdx:qemuArguments="zynq_imgproc_platform/standalone_domain/qemu/pmu_args.txt:zynq_imgproc_platform/standalone_domain/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_psu_cortexa53_0"
                            sdx:bif="zynq_imgproc_platform/boot/zynq_imgproc_platform.bif"
                            sdx:readme="zynq_imgproc_platform/boot/generic.readme"
                            sdx:qemuArguments="zynq_imgproc_platform/standalone_psu_cortexa53_0/qemu/pmu_args.txt:zynq_imgproc_platform/standalone_psu_cortexa53_0/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="zynq_imgproc_platform/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="zynq_imgproc_platform/standalone_domain/bspinclude/include"
                        sdx:bspConfig="zynq_imgproc_platform/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="standalone_psu_cortexa53_0"
                                sdx:displayName="standalone_psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="zynq_imgproc_platform/standalone_psu_cortexa53_0/bsplib/lib"
                        sdx:bspIncludePaths="zynq_imgproc_platform/standalone_psu_cortexa53_0/bspinclude/include"
                        sdx:bspConfig="zynq_imgproc_platform/standalone_psu_cortexa53_0/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
